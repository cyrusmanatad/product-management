FROM php:8.5-cli
RUN apt-get update && apt-get install -y libpq-dev libsqlite3-dev libonig-dev unzip git \
    && docker-php-ext-install pdo_pgsql pdo_sqlite mbstring bcmath pcntl \
    && rm -rf /var/lib/apt/lists/*
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
WORKDIR /app
ARG TEST_UID=1000
ARG TEST_GID=1000
RUN mkdir -p /app/vendor && chown ${TEST_UID}:${TEST_GID} /app/vendor
